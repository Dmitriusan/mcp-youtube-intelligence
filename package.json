{
  "name": "mcp-youtube-intelligence",
  "version": "0.1.13",
  "description": "MCP server for extracting structured intelligence from YouTube channels and videos — transcripts, topics, competitive signals",
  "mcpName": "io.github.dmitriusan/mcp-youtube-intelligence",
  "main": "build/index.js",
  "bin": {
    "mcp-youtube-intelligence": "build/index.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc && chmod 755 build/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "files": [
    "build/**/*.js",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "ai",
    "claude",
    "anthropic",
    "youtube",
    "transcript",
    "intelligence",
    "nlp",
    "content-analysis",
    "competitive-intelligence",
    "captions",
    "youtube-intelligence",
    "youtube-api"
  ],
  "author": "Dmytro Lisnichenko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Dmitriusan/mcp-youtube-intelligence"
  },
  "homepage": "https://github.com/Dmitriusan/mcp-youtube-intelligence#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^2.0.0"
  }
}
